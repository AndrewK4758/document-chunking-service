# gRPC Server Port
GRPC_PORT=11114

# Central AI Service Endpoint (For routing boundary detection & classification)
AI_SERVICE_URL=localhost:11111

# If a PDF has fewer pages than this, it will not be structurally split
MAX_PAGES_BEFORE_SPLIT=20

# Number of pages to extract per slice when searching for a document boundary
SLIDING_WINDOW_SIZE=5

# Maximum allowed size (in Megabytes) for a zip extraction (Protection against Zip bombs)
MAX_EXTRACTED_SIZE_MB=500

# Toggle sending JPEGs/Images vs raw PDF byte arrays for OCR Vision routing
ENABLE_PAGE_IMAGE_EXTRACTION=false

NACK_JSON_TIMEOUT=5

# Logger Settings
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28
LOG_COMPRESS=true
STORAGE_GATEWAY_ADDR=localhost:11118
NATS_URL=nats://127.0.0.1:4222
NATS_CONSUMER_RETRY_COUNT=90
NATS_CONSUMER_RETRY_SLEEP_SEC=2
LOG_FILE_PATH=../logs/document_processing_service.log
SERVICE_NAME=document_processing_service
LOG_PRETTY=true
